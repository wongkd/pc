@import "../styles/customer-tokens.wxss";

.customer-tabbar {
  position: fixed;
  z-index: 10;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  background: #fff;
  border-top: 1rpx solid #e5e5e5;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.customer-tabbar__items {
  display: flex;
  height: 104rpx;
  align-items: stretch;
}

.customer-tabbar__item {
  display: flex;
  flex: 1;
  min-width: 0;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 6rpx;
}

.customer-tabbar__icon {
  display: block;
  width: 40rpx;
  height: 40rpx;
}

.customer-tabbar__label {
  color: #808080;
  font-size: 23rpx;
  font-weight: 400;
  line-height: 1.2;
}

.customer-tabbar__label--selected {
  color: #111;
}
