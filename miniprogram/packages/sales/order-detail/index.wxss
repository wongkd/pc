/**
 * T02b · 事项详情页样式。
 *
 * 排版对齐依据：02 §4「详情页」的顺序，与 v3 设计稿
 * （docs/design/2026-09-17-style-exploration/v3/hybrid-mobile-detail.png）。
 * 只对呈现层：不改数据、不改动作、不新增业务入口。
 */

.page {
  min-height: 100vh;
  /* 预留底部固定操作条的高度，保证最后一条内容能滚到操作条上方（02 §4）。
     操作条 = 金额区 + 主动作；下端再叠安全区。 */
  padding-bottom: 320rpx;
  box-sizing: border-box;
}

.not-found {
  padding: var(--mp-s8) var(--mp-s4);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--mp-s2);
}

.not-found-title {
  font-size: var(--mp-fs-device);
  color: var(--mp-ink);
}

.not-found-hint {
  font-size: var(--mp-fs-secondary);
  color: var(--mp-muted);
  text-align: center;
}

.ghost-btn {
  margin-top: var(--mp-s3);
  min-height: var(--mp-touch);
  padding: 0 var(--mp-s5);
  display: flex;
  align-items: center;
  border: 1rpx solid var(--mp-ink);
  color: var(--mp-ink);
  border-radius: var(--mp-radius);
  font-size: var(--mp-fs-secondary);
}

/* ---------- 1 · 单号 / 类别 / 交期 ---------- */
.head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--mp-s3);
  padding: var(--mp-s3) var(--mp-s4) var(--mp-s2);
}

.head-top {
  display: flex;
  align-items: baseline;
  gap: var(--mp-s2);
  min-width: 0;
}

.entity-id {
  font-size: var(--mp-fs-secondary);
  line-height: 1.3;
  color: var(--mp-muted);
}

.category-tag {
  font-size: 22rpx;
  color: var(--mp-ink);
  background: var(--mp-sage);
  border-radius: var(--mp-radius);
  padding: 2rpx var(--mp-s2);
  flex: 0 0 auto;
}

.deadline {
  flex: 0 0 auto;
  font-size: var(--mp-fs-small);
  color: var(--mp-muted);
  text-align: right;
}

.deadline-overdue {
  color: var(--mp-danger);
}

/* ---------- 2 · 客户与事项（页面主标题） ---------- */
.headline {
  padding: 0 var(--mp-s4) var(--mp-s3);
  border-bottom: 1rpx solid var(--mp-line);
}

.headline-title {
  display: block;
  font-family: var(--mp-serif);
  font-size: 52rpx;
  line-height: 1.25;
  color: var(--mp-ink);
}

.headline-sub {
  display: block;
  margin-top: var(--mp-s1);
  font-size: var(--mp-fs-secondary);
  color: var(--mp-muted);
  line-height: 1.5;
}

/* ---------- 3–7 · 分区 ---------- */
.section {
  padding: var(--mp-s3) var(--mp-s4);
  border-bottom: 1rpx solid var(--mp-line);
}

.section-title {
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: var(--mp-muted);
  margin-bottom: var(--mp-s2);
}

/* 紧凑设备摘要：约 88–104px 图（02 §4），此处取 200rpx = 100px */
.device {
  display: flex;
  gap: var(--mp-s3);
  align-items: flex-start;
}

.device-thumb,
.device-img,
.device-fallback {
  width: 200rpx;
  height: 200rpx;
}

.device-thumb {
  flex: 0 0 200rpx;
  border-radius: var(--mp-radius);
  overflow: hidden;
  background: var(--mp-photo);
}

.device-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--mp-s2);
  box-sizing: border-box;
}

.device-fallback-text {
  font-size: var(--mp-fs-small);
  color: var(--mp-muted);
  text-align: center;
}

.device-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: var(--mp-s1);
}

/* 设备名用衬线（02 §1：衬线只用于页标题、设备名和少量大金额） */
.device-name {
  font-family: var(--mp-serif);
  font-size: var(--mp-fs-device);
  color: var(--mp-ink);
  line-height: 1.4;
}

.device-note {
  font-size: var(--mp-fs-small);
  color: var(--mp-muted);
}

.blocker {
  font-size: var(--mp-fs-body);
  color: var(--mp-warning);
  line-height: 1.6;
}

.next-action {
  font-size: var(--mp-fs-body);
  color: var(--mp-ink);
}

.blocked-reason {
  margin-top: var(--mp-s1);
  font-size: var(--mp-fs-small);
  color: var(--mp-danger);
  line-height: 1.6;
}

.muted {
  font-size: var(--mp-fs-secondary);
  color: var(--mp-muted);
  line-height: 1.7;
}

/* ---------- 8 · 底部固定金额与动作 ---------- */
/* 详情页只有这一个固定底部区域：不含 tabBar，也不堆第二层导航（02 §4） */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--mp-surface);
  border-top: 1rpx solid var(--mp-line);
  padding: var(--mp-s3) var(--mp-s4);
  padding-bottom: calc(var(--mp-s3) + env(safe-area-inset-bottom));
}

.amount {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  margin-bottom: var(--mp-s2);
}

.amount-label {
  font-size: 22rpx;
  color: var(--mp-muted);
}

.amount-line {
  display: flex;
  align-items: baseline;
  gap: var(--mp-s2);
}

.amount-value {
  font-size: var(--mp-fs-amount);
  line-height: 1.2;
  color: var(--mp-ink);
}

.amount-detail {
  font-size: var(--mp-fs-small);
  color: var(--mp-muted);
  line-height: 1.5;
}

.primary-btn {
  min-height: var(--mp-touch-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--mp-ink);
  color: var(--mp-surface);
  font-size: var(--mp-fs-body);
  border-radius: var(--mp-radius);
}

/* 阻断态：仍然可读、可解释原因，不是简单置灰到看不见（02 §6） */
.primary-btn-blocked {
  background: var(--mp-sage);
  color: var(--mp-muted);
}

.btn-hover {
  opacity: 0.75;
}
