<view class="page">
  <view class="not-found" wx:if="{{loaded && !task}}">
    <text class="not-found-title">没有找到这个事项</text>
    <text class="not-found-hint">链接可能已失效，或该事项不在你的可见范围内。</text>
    <view class="ghost-btn" hover-class="btn-hover" bindtap="onBackToday">回到今天</view>
  </view>

  <block wx:if="{{task}}">
    <view class="runtime-note">{{runtimeNote}}</view>

    <view class="head">
      <view class="head-top">
        <text class="entity-id mp-tabular">{{task.entityId}}</text>
        <text class="category-tag">{{task.categoryLabel}}</text>
      </view>
      <text class="deadline {{task.isOverdue ? 'deadline-overdue' : ''}}">{{task.deadlineText}}</text>
    </view>

    <view class="section">
      <view class="section-title">客户与事项</view>
      <view class="kv">
        <text class="k">客户</text>
        <text class="v">{{task.customer}}</text>
      </view>
      <view class="kv">
        <text class="k">事项</text>
        <text class="v">{{task.title}}</text>
      </view>
    </view>

    <view class="section">
      <view class="section-title">设备</view>
      <view class="device">
        <view class="device-thumb">
          <image
            wx:if="{{task.hasPhoto && !task.photoBroken}}"
            class="device-img"
            src="{{task.photoUrl}}"
            mode="aspectFill"
            binderror="onPhotoError"
          />
          <view wx:else class="device-fallback">
            <text class="device-fallback-text">{{task.photoLabel}}</text>
          </view>
        </view>
        <view class="device-main">
          <text class="device-name">{{task.device}}</text>
          <text class="device-note">{{task.photoLabel}}</text>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">当前处理</view>
      <view class="blocker" wx:if="{{task.blockerSummary}}">{{task.blockerSummary}}</view>
      <view class="muted" wx:else>当前没有记录的卡点</view>
    </view>

    <view class="section">
      <view class="section-title">下一步提示</view>
      <view class="next-action">{{task.actionLabel}}</view>
      <view class="blocked-reason" wx:if="{{task.blockerText}}">受阻：{{task.blockerText}}</view>
    </view>

    <view class="section">
      <view class="section-title">阶段与记录</view>
      <view class="muted">阶段序列与事件记录尚未接通（归 T08 / T12 / T18）。本页不显示推测的进度。</view>
    </view>

    <view class="action-bar">
      <view class="amount">
        <view class="amount-line" wx:if="{{task.amountPrimary}}">
          <text class="amount-value mp-tabular">{{task.amountPrimary}}</text>
          <text class="amount-direction">{{task.amountDirection}}</text>
        </view>
        <view class="amount-line" wx:else>
          <text class="amount-direction">{{task.amountDirection}}</text>
        </view>
        <text class="amount-detail">{{task.amountDetail}}</text>
      </view>
      <view
        class="primary-btn {{task.actionEnabled ? '' : 'primary-btn-blocked'}}"
        hover-class="{{task.actionEnabled ? 'btn-hover' : ''}}"
        bindtap="onPrimaryAction"
      >{{task.actionLabel}}</view>
    </view>
  </block>
</view>
