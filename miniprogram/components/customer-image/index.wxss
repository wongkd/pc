@import "../../styles/customer-tokens.wxss";

.customer-image-frame {
  position: relative;
  overflow: hidden;
  width: 100%;
  box-sizing: border-box;
  background: var(--customer-photo);
}

.customer-image-frame__image,
.customer-image-frame__placeholder,
.customer-image-frame__fallback {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.customer-image-frame__image {
  display: block;
  right: auto;
  bottom: auto;
}

.customer-image-frame__placeholder {
  background: linear-gradient(90deg, #f5f5f5, #ededed, #f5f5f5);
}

.customer-image-frame__fallback {
  display: flex;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 8rpx;
  padding: 16rpx;
  color: var(--customer-muted);
  text-align: center;
  background: #f5f5f5;
}

.customer-image-frame__fallback-text,
.customer-image-frame__alt {
  display: -webkit-box;
  max-width: 100%;
  overflow: hidden;
  word-break: break-all;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.customer-image-frame__fallback-text {
  font-size: 25rpx;
}

.customer-image-frame__alt {
  font-size: 21rpx;
  line-height: 1.35;
}
