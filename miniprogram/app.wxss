@import "styles/customer-tokens.wxss";

/**
 * T02b · 小程序全局样式与设计变量。
 *
 * 值来源：docs/plans/2026-09-17-web-wechat-plan/02-ui-specification.md §1「设计变量」。
 * 与网页端 frontend/src/styles/theme.css 同源，但**不复用其变量名**：
 * 网页端变量挂在 .app-shell 上，两端是各自独立的编译链，没有共享前提。
 *
 * 单位换算（设计宽度 375px，1rpx = 0.5px）：
 *   正文 16px = 32rpx，辅助 13–14px = 26–28rpx，主标题 22–26px = 44–52rpx
 *   触控最小 44px = 88rpx，主动作 48px = 96rpx
 *
 * 字号采用 02 §1 的小程序档位（正文 / 输入 16px），**不照搬原型的 9–11px 小字**。
 * 字体：02 要求小程序「优先系统字体」，故本卡不引入衬线字体，避免不同系统回退不一致；
 * 是否引入获授权的中文字体子集，待真机验证后再定。
 */

page {
  --mp-paper: #f8f6ef;
  --mp-ink: #334b42;
  --mp-muted: #687365;
  --mp-line: #d9ddd0;
  --mp-sage: #e8edde;
  --mp-photo: #ece9de;
  --mp-surface: #fffef9;

  --mp-warning: #826021;
  --mp-warning-bg: #f1e9d2;
  --mp-danger: #9b3c32;
  --mp-danger-bg: #f5e6e2;

  --mp-fs-body: 32rpx;
  --mp-fs-secondary: 28rpx;
  --mp-fs-small: 26rpx;
  --mp-fs-device: 34rpx;
  --mp-fs-title: 44rpx;
  --mp-fs-amount: 48rpx;

  /* 衬线：02 §1 只允许用在页标题、设备名和少量大金额。
     取系统自带宋体，**不加载远程字体** —— 02 §1 要求「首版不依赖远程中文字体
     保证页面可用」。Android 缺少其中部分字面时回退为无衬线，属规格预期内的降级，
     是否引入获授权的中文字体子集待真机验证后再定。 */
  --mp-serif: 'Songti SC', 'STSong', 'SimSun', 'Noto Serif CJK SC', serif;

  --mp-s1: 8rpx;
  --mp-s2: 16rpx;
  --mp-s3: 24rpx;
  --mp-s4: 32rpx;
  --mp-s5: 40rpx;
  --mp-s6: 48rpx;
  --mp-s8: 64rpx;

  --mp-radius: 8rpx;
  --mp-radius-dialog: 16rpx;
  --mp-touch: 88rpx;
  --mp-touch-primary: 96rpx;

  background: var(--mp-paper);
  color: var(--mp-ink);
  font-size: var(--mp-fs-body);
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB',
    'Microsoft YaHei', sans-serif;
}

/* 单条主滚动轴：固定底部操作条的场景由页面自行预留等高占位 */
.mp-scroll {
  height: 100%;
}

/* Shared local PNG assets; geometry and rebuild entry live in the icon delivery README. */
.mp-ui-icon {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
  margin-right: 10rpx;
}
.mp-brand-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.mp-entry-heading {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.mp-entry-icon {
  width: 44rpx;
  height: 44rpx;
  padding: 12rpx;
  border-radius: 12rpx;
  background: var(--mp-sage);
  flex-shrink: 0;
}
.mp-empty-art {
  display: block;
  width: 280rpx;
  height: 280rpx;
  margin: 0 auto 20rpx;
}

/* 页标题与区块标题 */
.mp-page-title {
  font-family: var(--mp-serif);
  font-size: var(--mp-fs-title);
  line-height: 1.3;
  font-weight: 500;
}

.mp-section-title {
  font-size: var(--mp-fs-secondary);
  color: var(--mp-muted);
  letter-spacing: 1rpx;
}

/* 金额与编号等宽数字，小数位不为了「好看」被吞掉（02 §1） */
.mp-tabular {
  font-variant-numeric: tabular-nums;
}

/* 分隔线统一用 1 物理像素视觉厚度 */
.mp-hairline {
  height: 1rpx;
  background: var(--mp-line);
}

/* 整行可点：把最小触控尺寸做在行上，而不是只做在文字上（02 §4） */
.mp-tap {
  min-height: var(--mp-touch);
}

.mp-empty {
  padding: var(--mp-s8) var(--mp-s4);
  text-align: center;
  color: var(--mp-muted);
  font-size: var(--mp-fs-secondary);
}

/* 运行状态说明：如实说明数据来源与未接通范围。
   02 §9 明确「示例数据」属评审环境内容、不是生产页面标题，
   故不做顶部横幅，只放在页面末尾，小字、不抢主信息层级。 */
.mp-runtime-note {
  margin: var(--mp-s6) var(--mp-s4) 0;
  padding-top: var(--mp-s3);
  border-top: 1rpx solid var(--mp-line);
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--mp-muted);
}

/* 域落地页（T02b）：三个域页共用排版，文案由各页 data 提供。
   放在 app.wxss 而不是各页复制，避免三份同样的样式各自漂移。 */
.mp-landing {
  padding: var(--mp-s4);
}

.mp-landing-kicker {
  font-size: var(--mp-fs-small);
  color: var(--mp-muted);
}

.mp-landing-title {
  display: block;
  margin-top: var(--mp-s1);
  font-size: var(--mp-fs-title);
  line-height: 1.3;
  color: var(--mp-ink);
}

.mp-landing-intro {
  display: block;
  margin-top: var(--mp-s2);
  font-size: var(--mp-fs-secondary);
  color: var(--mp-muted);
  line-height: 1.6;
}

.mp-landing-list {
  margin-top: var(--mp-s4);
  display: flex;
  flex-direction: column;
  gap: var(--mp-s2);
}

.mp-landing-item {
  padding: var(--mp-s3);
  background: var(--mp-surface);
  border: 1rpx solid var(--mp-line);
  border-radius: var(--mp-radius);
}

.mp-landing-item-name {
  font-size: var(--mp-fs-body);
  color: var(--mp-ink);
}

.mp-landing-item-desc {
  display: block;
  margin-top: var(--mp-s1);
  font-size: var(--mp-fs-small);
  color: var(--mp-muted);
  line-height: 1.6;
}

.mp-landing-item-state {
  display: block;
  margin-top: var(--mp-s2);
  font-size: var(--mp-fs-small);
  color: var(--mp-muted);
}

.mp-landing-notes {
  margin-top: var(--mp-s6);
  padding: var(--mp-s3);
  background: var(--mp-sage);
  border-radius: var(--mp-radius);
}

.mp-landing-notes-title {
  font-size: var(--mp-fs-secondary);
  color: var(--mp-ink);
}

.mp-landing-notes-text {
  display: block;
  margin-top: var(--mp-s1);
  font-size: var(--mp-fs-small);
  color: var(--mp-muted);
  line-height: 1.7;
  white-space: pre-line;
}
