@import "../../styles/customer-tokens.wxss";

page { height: 100%; background: #fff; }

.home-page {
  display: flex;
  height: 100%;
  flex-direction: column;
  overflow: hidden;
}

.home-scroll {
  flex: 1;
  min-height: 0;
  height: 0;
  padding-bottom: calc(104rpx + env(safe-area-inset-bottom));
}

.home-brand {
  position: relative;
  box-sizing: border-box;
  height: 320rpx;
  padding: 40rpx 56rpx 0;
}

.home-wordmark-frame {
  position: relative;
  width: 530rpx;
  height: 168rpx;
  overflow: hidden;
}

/* 原 PNG 的有效墨迹为 (199,78)-(736,247)，裁掉透明留白后再按稿定尺寸。 */
.home-wordmark {
  position: absolute;
  left: -196rpx;
  top: -77rpx;
  display: block;
  width: 888rpx;
  height: 296rpx;
}

.home-slogan {
  display: block;
  margin-top: 25rpx;
  color: var(--customer-ink);
  font-size: 35rpx;
  font-weight: var(--customer-fw-regular);
  letter-spacing: 1rpx;
  line-height: 1.35;
}

.home-hero {
  position: relative;
  width: 100%;
}

.home-cats-frame {
  position: absolute;
  z-index: 1;
  top: -64rpx;
  right: 20rpx;
  width: 220rpx;
  height: 150rpx;
  overflow: hidden;
}

.home-cats {
  position: absolute;
  left: -120rpx;
  top: -77rpx;
  width: 450rpx;
  height: 300rpx;
}

.home-services {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  padding: 28rpx 12rpx 24rpx;
}

.home-service {
  display: flex;
  flex: 1;
  min-width: 0;
  min-height: 164rpx;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  gap: 18rpx;
}

.home-service-icon {
  display: block;
  width: 58rpx;
  height: 58rpx;
}

.home-service-label {
  max-width: 100%;
  overflow: hidden;
  color: var(--customer-ink);
  font-size: 26rpx;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-divider {
  margin: 10rpx 32rpx 40rpx;
}

.home-recommendation {
  position: relative;
  overflow: hidden;
  margin: 0 32rpx;
  background: #f5f5f5;
}

.home-banner-copy {
  position: absolute;
  top: 50%;
  left: 24rpx;
  display: flex;
  max-width: 56%;
  flex-direction: column;
  gap: 4rpx;
  transform: translateY(-50%);
}

.home-banner-title {
  color: var(--customer-ink);
  font-size: 32rpx;
  font-weight: var(--customer-fw-emphasis);
  line-height: 1.35;
}

.home-banner-description {
  color: var(--customer-muted);
  font-size: 21rpx;
  line-height: 1.4;
}

.home-banner-arrow {
  position: absolute;
  top: 50%;
  right: 10rpx;
  width: 32rpx;
  height: 32rpx;
  transform: translateY(-50%);
}

.home-demo-note {
  display: block;
  padding: 16rpx 32rpx 24rpx;
  color: var(--customer-muted);
  font-size: 20rpx;
  line-height: 1.5;
}
