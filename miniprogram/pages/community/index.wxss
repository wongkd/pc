page { height: 100%; background: #fff; }
.community-page { height: 100%; display: flex; flex-direction: column; background: #fff; }
.community-tabs { flex: none; white-space: nowrap; border-bottom: 1rpx solid #eee; }
.community-tabs-inner { display: flex; padding: 0 24rpx; }
.community-tab { position: relative; flex: 1; min-width: 190rpx; height: 88rpx; display: flex; align-items: center; justify-content: center; color: #808080; font-size: 30rpx; }
.community-tab.is-selected { color: #111; }
.community-tab-line { position: absolute; bottom: 0; left: 20%; width: 60%; height: 3rpx; background: #111; }
.community-scroll { flex: 1; height: 0; min-height: 0; padding: 34rpx 32rpx calc(104rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.community-list { display: flex; flex-direction: column; }
.community-card { overflow: hidden; background: #fff; border-bottom: 1rpx solid #e5e5e5; margin-bottom: 26rpx; }
.community-image-wrap { position: relative; overflow: hidden; background: #f3f3f3; border-radius: 6rpx; }
.community-cover { display: block; width: 100%; }
.community-cat { position: absolute; right: 0; bottom: -10rpx; width: 106rpx; height: 82rpx; }
.community-card-body { padding: 18rpx 0 20rpx; }
.community-date { color: #808080; font-size: 25rpx; }
.community-title { display: block; color: #111; font-size: 34rpx; font-weight: 400; line-height: 1.45; }
.community-summary { display: block; margin-top: 10rpx; color: #808080; font-size: 26rpx; line-height: 1.5; }
.community-card-foot { display: flex; align-items: center; justify-content: space-between; min-height: 50rpx; margin-top: 20rpx; }
.community-arrow { width: 28rpx; height: 28rpx; }
.community-card-horizontal { display: flex; align-items: stretch; gap: 26rpx; padding: 0 0 20rpx; margin-bottom: 0; }
.community-card-horizontal .community-image-wrap { flex: none; width: 270rpx; }
.community-card-horizontal .community-cover { height: auto; }
.community-card-horizontal .community-card-body { flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: center; padding: 0; }
.community-card-horizontal .community-title { margin-top: 7rpx; font-size: 30rpx; }
.community-card-horizontal .community-summary { display: -webkit-box; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; font-size: 25rpx; }
.community-card-horizontal .community-card-foot { margin-top: auto; }
.community-runtime-note { padding: 24rpx 0; color: #999; font-size: 20rpx; line-height: 1.5; }
