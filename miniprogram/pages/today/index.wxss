/**
 * T02b · 今天页样式。
 *
 * 排版对齐依据：02 §4「今天页」的顺序（品牌和开单 → 四项统计 → 待办标题 / 视图
 * → 搜索与扫码 → 事项筛选 → 竖向列表）与 v3 设计稿
 * （docs/design/2026-09-17-style-exploration/v3/hybrid-mobile-board.png）。
 *
 * 只对呈现层：不改数据、不改跳转、不新增业务控件。
 */

.today {
  min-height: 100vh;
  padding-bottom: var(--mp-s6);
}

/* ---------- 品牌与开单 ---------- */
/* 02 §4「应用品牌与＋开单置于下方紧凑行」，不画假胶囊 */
.brand-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--mp-s3) var(--mp-s4);
  background: var(--mp-surface);
  border-bottom: 1rpx solid var(--mp-line);
}

.brand {
  display: flex;
  align-items: center;
  gap: var(--mp-s2);
}

.brand-name {
  font-family: var(--mp-serif);
  font-size: 44rpx;
  line-height: 1;
  color: var(--mp-ink);
  letter-spacing: 3rpx;
}

/* 「工作台」竖排：逐字纵向排列。
   不用 writing-mode —— 部分机型 WebView 对竖排回流处理不一致，
   逐字排列在任何机型都得到同一结果。 */
.brand-store {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-left: var(--mp-s2);
  border-left: 2rpx solid var(--mp-line);
}

.brand-store-char {
  font-size: 22rpx;
  line-height: 1.1;
  color: var(--mp-muted);
}

.create-btn {
  min-height: var(--mp-touch);
  padding: 0 var(--mp-s4);
  display: flex;
  align-items: center;
  background: var(--mp-ink);
  color: var(--mp-surface);
  font-size: var(--mp-fs-secondary);
  border-radius: var(--mp-radius);
}

/* ---------- 四项统计 ---------- */
/* 02 §103：宽屏四列；320px 或大金额时允许两行两列。
   用竖分隔线而非卡片边框 —— 02 §1 禁止「多彩统计卡」。 */
.metrics {
  display: flex;
  align-items: stretch;
  background: var(--mp-surface);
  border-bottom: 1rpx solid var(--mp-line);
}

.metric {
  flex: 1 1 0;
  min-width: 0;
  min-height: var(--mp-touch);
  padding: var(--mp-s2) 4rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
}

.metric + .metric {
  border-left: 1rpx solid var(--mp-line);
}

/* 金额格比计数格宽：它是这一行里唯一可能到十位字符的值（`¥12,800.00` 本身就 10 字符，
   而三个计数格最多两三位）。等分四格的 179.5rpx 装不下，T02b §14.2 实测就是这么被裁的。
   260rpx 与 features/amount-view.ts 的 METRIC_VALUE_BUDGET_PX 配套，
   **改这里必须同步改那个常量**，否则字号档位算出来的字宽就不作数。 */
.metric-money {
  min-width: 260rpx;
}

.metric-value {
  font-size: 40rpx;
  line-height: 1.2;
  color: var(--mp-ink);
  /* 金额换行比缩小更糟：断成两行会被读成两个数（02 §103 不许出现无法核账的数）。
     放不下时的正确手段是降档字号（下面几档）或加宽格子，不是换行。 */
  white-space: nowrap;
}

/* 数值字号分档。档位由 features/amount-view.ts 的 metricValueClass() 按字符类别算，
   不是手挑的；类名与那里的 METRIC_VALUE_TIERS 一一对应，改一处必须改另一处。 */
.metric-value-md {
  font-size: 36rpx;
}

.metric-value-sm {
  font-size: 32rpx;
}

.metric-value-xs {
  font-size: 28rpx;
}

.metric-label {
  font-size: 22rpx;
  line-height: 1.2;
  color: var(--mp-muted);
  white-space: nowrap;
}

/* 窄屏两行两列：金额不被压到不可读（02 §103） */
@media (max-width: 360px) {
  .metrics {
    flex-wrap: wrap;
    padding: var(--mp-s2) var(--mp-s4);
    gap: var(--mp-s2);
  }

  .metric {
    flex: 0 0 calc(50% - var(--mp-s1));
    border: 1rpx solid var(--mp-line);
    border-radius: var(--mp-radius);
  }

  .metric + .metric {
    border-left: 1rpx solid var(--mp-line);
  }

  /* 两行两列时每格 ≈140px，已宽于金额格的下限，若沿用 min-width 会让两列不再等分。 */
  .metric-money {
    min-width: 0;
  }
}

/* ---------- 待办标题 ---------- */
.todo-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--mp-s2);
  padding: var(--mp-s4) var(--mp-s4) var(--mp-s2);
}

.todo-head-left {
  display: flex;
  align-items: baseline;
  gap: var(--mp-s2);
  min-width: 0;
}

.todo-title {
  font-family: var(--mp-serif);
  font-size: 40rpx;
  line-height: 1.2;
  color: var(--mp-ink);
}

.todo-count {
  font-size: 40rpx;
  line-height: 1.2;
  color: var(--mp-ink);
}

/* ---------- 搜索与扫码 ---------- */
/* 02 §40：今天页动作含「筛选、选单、扫码、开单」，故保留扫码入口 */
.search-row {
  display: flex;
  gap: var(--mp-s2);
  padding: 0 var(--mp-s4);
}

.search-box {
  flex: 1;
  min-width: 0;
  min-height: var(--mp-touch);
  display: flex;
  align-items: center;
  padding: 0 var(--mp-s3);
  background: var(--mp-surface);
  border: 1rpx solid var(--mp-line);
  border-radius: var(--mp-radius);
}

.search-placeholder {
  font-size: var(--mp-fs-secondary);
  color: var(--mp-muted);
}

.scan-btn {
  min-height: var(--mp-touch);
  padding: 0 var(--mp-s4);
  display: flex;
  align-items: center;
  background: var(--mp-sage);
  color: var(--mp-ink);
  font-size: var(--mp-fs-secondary);
  border-radius: var(--mp-radius);
}

/* ---------- 事项筛选 ---------- */
/* 下划线式页签：选中态是深绿短线，不是胶囊 —— 与设计稿一致，也避免彩色按钮堆叠 */
.filters {
  display: flex;
  gap: var(--mp-s5);
  padding: 0 var(--mp-s4) var(--mp-s3);
  margin-top: var(--mp-s3);
  border-bottom: 1rpx solid var(--mp-line);
  white-space: nowrap;
}

.filter {
  position: relative;
  min-height: 72rpx;
  display: flex;
  align-items: center;
  flex: 0 0 auto;
  font-size: var(--mp-fs-secondary);
  color: var(--mp-muted);
}

.filter-on {
  color: var(--mp-ink);
}

.filter-on::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 4rpx;
  background: var(--mp-ink);
}

/* ---------- 分组标题 ---------- */
.group-head {
  padding: var(--mp-s3) var(--mp-s4) var(--mp-s1);
  font-size: var(--mp-fs-small);
  color: var(--mp-muted);
}

.empty {
  padding: var(--mp-s8) var(--mp-s4);
  text-align: center;
  font-size: var(--mp-fs-secondary);
  color: var(--mp-muted);
}

/* ---------- 竖向列表 ---------- */
.rows {
  padding: 0 var(--mp-s4);
}

/* 任务行：60px 缩略图 + 客户/设备 + 卡点 + 时间与动作 + 金额；整行可点（02 §4） */
.row {
  display: flex;
  align-items: stretch;
  gap: var(--mp-s3);
  padding: var(--mp-s3) 0;
  border-bottom: 1rpx solid var(--mp-line);
}

.row-hover {
  background: var(--mp-sage);
}

.btn-hover {
  opacity: 0.75;
}

.metric-hover {
  background: var(--mp-sage);
}

.thumb,
.thumb-img,
.thumb-fallback {
  width: 120rpx;
  height: 120rpx;
}

.thumb {
  position: relative;
  flex: 0 0 120rpx;
  border-radius: var(--mp-radius);
  overflow: hidden;
  background: var(--mp-photo);
}

.thumb-label {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 2rpx;
  background: var(--mp-paper);
  color: var(--mp-muted);
  font-size: 20rpx;
  line-height: 1.3;
  text-align: center;
}

.thumb-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--mp-s1);
  box-sizing: border-box;
}

.thumb-fallback-text {
  font-size: var(--mp-fs-small);
  color: var(--mp-muted);
  text-align: center;
}

.row-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.row-head {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: var(--mp-s2);
}

.row-customer {
  font-size: var(--mp-fs-body);
  color: var(--mp-ink);
}

.row-device {
  font-size: var(--mp-fs-secondary);
  color: var(--mp-muted);
  /* 长设备名最多两行，电话与 SN 进入详情（02 §4） */
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.row-blocker-summary {
  font-size: var(--mp-fs-secondary);
  color: var(--mp-warning);
  line-height: 1.5;
}

.row-meta {
  display: flex;
  flex-wrap: wrap;
  gap: var(--mp-s2);
  align-items: baseline;
  justify-content: space-between;
}

.row-deadline {
  font-size: var(--mp-fs-small);
  color: var(--mp-muted);
}

/* 逾期必须写字，不只变红（02 §4） */
.row-deadline-overdue {
  color: var(--mp-danger);
}

.row-action {
  font-size: var(--mp-fs-small);
  color: var(--mp-ink);
}

.row-action-blocked {
  color: var(--mp-muted);
}

.row-amount-line {
  display: flex;
  align-items: baseline;
  gap: var(--mp-s2);
}

.row-amount {
  font-size: var(--mp-fs-body);
  color: var(--mp-ink);
}

.row-amount-dir {
  font-size: var(--mp-fs-small);
  color: var(--mp-muted);
}

/* 阻断原因：动作不可点时必须给出可读原因（02 §6），但视觉上不与主信息争层级 */
.row-blocked-reason {
  font-size: var(--mp-fs-small);
  color: var(--mp-danger);
  line-height: 1.5;
}

.row-arrow {
  display: flex;
  align-items: center;
  color: var(--mp-muted);
  font-size: var(--mp-fs-device);
}
