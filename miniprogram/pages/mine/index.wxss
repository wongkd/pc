page { height: 100%; background: #fff; }
.mine-page { height: 100%; display: flex; flex-direction: column; background: #fff; }
.mine-scroll { flex: 1; height: 0; min-height: 0; padding: 22rpx 32rpx calc(104rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.mine-head { min-height: 180rpx; display: flex; align-items: center; gap: 34rpx; }
.mine-avatar { flex: none; width: 168rpx; height: 168rpx; border-radius: 50%; background: #eee; }
.mine-avatar-fallback { display: flex; align-items: center; justify-content: center; color: #888; font-size: 36rpx; }
.mine-head-text { flex: 1; min-width: 0; }
.mine-head-name { display: block; color: #111; font-size: 34rpx; font-weight: 400; }
.mine-head-hint { display: block; margin-top: 10rpx; color: #808080; font-size: 25rpx; }
.mine-head-arrow { color: #111; font-size: 36rpx; }
.mine-archive { position: relative; display: flex; align-items: center; min-height: 234rpx; margin-top: 38rpx; padding: 28rpx 38rpx; box-sizing: border-box; background: #f8f0dc; border-radius: 6rpx; }
.mine-archive-copy { position: relative; z-index: 1; }
.mine-archive-title { display: block; color: #111; font-size: 38rpx; }
.mine-archive-subtitle { display: block; margin-top: 12rpx; color: #767676; font-size: 25rpx; }
.mine-archive-link { position: absolute; right: 36rpx; bottom: 40rpx; color: #666; font-size: 25rpx; }
.mine-archive-cat { position: absolute; right: -44rpx; top: -78rpx; width: 300rpx; height: 228rpx; }
.mine-stats { display: flex; margin: 56rpx 0 26rpx; padding: 0 0 74rpx; border-bottom: 1rpx solid #dcdcdc; }
.mine-stat { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; border-right: 1rpx solid #e5e5e5; }
.mine-stat:last-child { border-right: 0; }
.mine-stat-value { color: #111; font-size: 46rpx; line-height: 1.25; }
.mine-stat-label { margin-top: 8rpx; color: #808080; font-size: 26rpx; }
.mine-menu { border-bottom: 1rpx solid #dcdcdc; }
.mine-menu-row { min-height: 116rpx; display: flex; align-items: center; gap: 24rpx; }
.mine-menu-icon,.mine-store-icon { flex: none; width: 42rpx; height: 42rpx; }
.mine-menu-title,.mine-store-name { flex: 1; color: #222; font-size: 30rpx; }
.mine-menu-arrow { flex: none; width: 24rpx; height: 24rpx; }
.mine-store { min-height: 148rpx; display: flex; align-items: center; gap: 24rpx; }
.mine-footer { position: relative; min-height: 238rpx; display: flex; align-items: center; justify-content: flex-end; padding-right: 126rpx; box-sizing: border-box; }
.mine-footer-copy { color: #111; text-align: right; white-space: pre-line; font-size: 28rpx; line-height: 1.8; letter-spacing: 4rpx; }
.mine-footer-cat { position: absolute; right: 0; bottom: 0; width: 150rpx; height: 108rpx; }
.mine-runtime-note { padding: 24rpx 0; color: #999; font-size: 20rpx; line-height: 1.45; }
