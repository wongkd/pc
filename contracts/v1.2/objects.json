{
  "contractVersion": "v1.2",
  "frozenBy": "U02",
  "frozenAt": "2026-09-27",
  "status": "frozen",
  "source": "docs/plans/2026-09-17-web-wechat-plan/04-data-and-api.md §2",
  "structureNote": "以下是逻辑对象，不意味着每个对象独占一张新表。新表按任务增量建立，不在 v2 旁复制第二套互不相通的 ERP。复用旧表的对象在 tables 中声明，映射细节见 legacy-mapping.json。",

  "commonFields": {
    "id": { "type": "id", "nullable": false, "desc": "不透明字符串，客户端不得解析主键" },
    "storeId": { "type": "id", "nullable": false, "desc": "由后端身份派生，忽略客户端传值" },
    "version": { "type": "int", "nullable": false, "desc": "非负整数，每次有效写入 +1" },
    "createdAt": { "type": "timestamp", "nullable": false },
    "updatedAt": { "type": "timestamp", "nullable": false },
    "createdBy": { "type": "id", "nullable": false, "desc": "成员 ID，不是用户邮箱" }
  },

  "eventFields": {
    "occurredAt": { "type": "timestamp", "nullable": false, "desc": "实际业务发生时间，与预约时间分开" },
    "recordedAt": { "type": "timestamp", "nullable": false, "desc": "记录写入时间" },
    "actorId": { "type": "id", "nullable": false },
    "requestId": { "type": "string", "nullable": false },
    "sourceType": { "type": "enum", "enumRef": "EntityType", "nullable": false },
    "sourceId": { "type": "id", "nullable": true }
  },

  "globalRules": [
    "所有持久对象默认包含 commonFields；正式事件类对象另含 eventFields 的相关子集。",
    "后端校验子对象确实属于同店，不能只检查父单。",
    "可选关联写显式 null，不用 0 或空串表示「无」。",
    "内部成本、供应商、毛利字段仅在有权限的响应中出现，不靠前端隐藏。"
  ],

  "objects": {
    "Product": {
      "tables": ["hardware"],
      "desc": "型号 / 服务项目主数据",
      "fields": {
        "sku": { "type": "string", "nullable": false },
        "name": { "type": "string", "nullable": false },
        "category": { "type": "string", "nullable": false },
        "brand": { "type": "string", "nullable": true },
        "specs": { "type": "string", "nullable": true },
        "trackingMode": { "type": "enum", "enumRef": "TrackingMode", "nullable": false },
        "requiresSn": { "type": "bool", "nullable": false },
        "status": { "type": "enum", "enumRef": "ActiveStatus", "nullable": false },
        "defaultSalePriceCents": { "type": "cents", "nullable": false },
        "warrantyTemplate": { "type": "object", "nullable": true }
      },
      "rules": [
        "复用 hardware 的映射，不直接按同名合并。",
        "关键属性已发生业务后修改需专门规则，不静默改写历史单据。"
      ]
    },

    "StockBalance": {
      "tables": ["stock_balances"],
      "desc": "型号 × 位置的数量余额",
      "fields": {
        "productId": { "type": "id", "nullable": false },
        "locationId": { "type": "id", "nullable": false },
        "availableQty": { "type": "int", "nullable": false },
        "reservedQty": { "type": "int", "nullable": false },
        "quarantineQty": { "type": "int", "nullable": false },
        "totalCostCents": { "type": "cents", "nullable": true },
        "costKnown": { "type": "bool", "nullable": false }
      },
      "rules": [
        "汇总可重算；不得成为缺少流水的手改数字。",
        "totalCostCents 在存在未知成本批次时为 null，且 costKnown=false，不得估成 0。"
      ]
    },

    "StockItem": {
      "tables": ["serial_numbers"],
      "desc": "逐件实物",
      "fields": {
        "assetCode": { "type": "string", "nullable": false, "desc": "内部唯一编号；二手必有，即使没有厂商 SN" },
        "productId": { "type": "id", "nullable": false },
        "condition": { "type": "enum", "enumRef": "StockCondition", "nullable": false },
        "snRaw": { "type": "string", "nullable": true, "desc": "原始显示值，保留大小写与符号" },
        "snNormalized": { "type": "string", "nullable": true, "desc": "规范化检索值" },
        "ownership": { "type": "enum", "enumRef": "OwnershipType", "nullable": false },
        "availability": { "type": "enum", "enumRef": "StockBucket", "nullable": false },
        "inspectionStatus": { "type": "enum", "enumRef": "InspectionStatus", "nullable": false, "desc": "当前检测投影；旧记录为 unrecorded（历史未记录），不得按库存桶或旧 inspection_ref 推断" },
        "location": { "type": "enum", "enumRef": "LocationKind", "nullable": false },
        "acquisitionRef": { "type": "id", "nullable": true },
        "acquisitionCostCents": { "type": "cents", "nullable": true },
        "refurbishmentCostCents": { "type": "cents", "nullable": true },
        "costKnown": { "type": "bool", "nullable": false },
        "inspectionRef": { "type": "id", "nullable": true },
        "warrantySnapshot": { "type": "object", "nullable": true },
        "conditionGrade": { "type": "enum", "enumRef": "ConditionGrade", "nullable": true, "desc": "逐件成色等级（B30 上架门槛之一）。整备上架前必须补齐" },
        "salePriceCents": { "type": "cents", "nullable": true, "desc": "逐件标价（B30 上架门槛之一）。二手件一机一价，故落在件上而非商品上；商品级挂牌价见 Product.defaultSalePriceCents" },
        "disclosureNote": { "type": "string", "nullable": true, "desc": "已知缺陷披露的自由文本（B30 上架门槛之一）。会写进顾客报价单，不含成本与卖方信息" },
        "dataDisposed": { "type": "bool", "nullable": true, "desc": "存储设备客户数据已处置确认（B30 上架门槛之一）。法规要求，必须显式确认，不得默认通过" },
        "warrantyTerm": { "type": "enum", "enumRef": "WarrantyTerm", "nullable": true, "desc": "本店质保月数（B30 上架门槛之一）" }
      },
      "rules": [
        "重复 SN 进入人工核对，不自动合并所有权记录。",
        "当前状态与完整事件历史并存，不能用一个状态字段代替全部事实。",
        "检测失败后必须完成返修并追加 B48 事件，再以新 requestId 复检；失败状态不能直接转可售。"
      ]
    },

    "StockInspectionEvent": {
      "tables": ["stock_inspection_events"],
      "desc": "逐件检测与返修的追加式事件",
      "fields": {
        "stockItemId": { "type": "id", "nullable": false },
        "eventType": { "type": "enum", "enumRef": "InspectionEventType", "nullable": false },
        "fromStatus": { "type": "enum", "enumRef": "InspectionStatus", "nullable": false },
        "toStatus": { "type": "enum", "enumRef": "InspectionStatus", "nullable": false },
        "result": { "type": "enum", "enumRef": "InspectionResult", "nullable": true },
        "findings": { "type": "string", "nullable": false },
        "evidence": { "type": "array", "nullable": false },
        "occurredAt": { "type": "timestamp", "nullable": false },
        "recordedAt": { "type": "timestamp", "nullable": false },
        "actorId": { "type": "id", "nullable": false },
        "requestId": { "type": "string", "nullable": false },
        "stockItemVersion": { "type": "int", "nullable": false }
      },
      "rules": ["事件不可更新或刪除；当前状态投影与事件必须在同一业务操作中推进。", "返修事件不代表检测通过，必须另追加检测事件。"]
    },

    "StockBackfill": {
      "tables": ["inventory_stock_backfills"],
      "desc": "同型号分批库存补录批次",
      "fields": {
        "batchRef": { "type": "string", "nullable": false },
        "note": { "type": "string", "nullable": true },
        "requestId": { "type": "string", "nullable": false },
        "payloadHash": { "type": "string", "nullable": false },
        "occurredAt": { "type": "timestamp", "nullable": false },
        "recordedAt": { "type": "timestamp", "nullable": false },
        "actorId": { "type": "id", "nullable": false }
      },
      "rules": ["门店内 batchRef 唯一；同一批次换 requestId 不得再次增加库存。", "B13 首次期初守卫保持不变。"]
    },

    "StockBackfillLine": {
      "tables": ["inventory_stock_backfill_lines"],
      "desc": "补录批次明细及稳定行引用",
      "fields": {
        "backfillId": { "type": "id", "nullable": false },
        "lineRef": { "type": "string", "nullable": false },
        "productId": { "type": "id", "nullable": false },
        "trackingMode": { "type": "enum", "enumRef": "TrackingMode", "nullable": false },
        "qty": { "type": "int", "nullable": false },
        "stockItemId": { "type": "id", "nullable": true },
        "stockBatchId": { "type": "id", "nullable": true }
      },
      "rules": ["同一补录批次内 lineRef 唯一；无 SN 相似件只提示人工复核，不承诺自动判重。"]
    },

    "Customer": {
      "tables": ["customers"],
      "desc": "客户 / 卖方",
      "fields": {
        "displayName": { "type": "string", "nullable": false },
        "phone": { "type": "string", "nullable": true },
        "contactNote": { "type": "string", "nullable": true },
        "remarkInternal": { "type": "string", "nullable": true },
        "sourceChannel": { "type": "enum", "enumRef": "CustomerSourceChannel", "nullable": true }
      },
      "rules": [
        "散客允许最少信息。",
        "卖方和买方不是同一个可覆盖字段；同一主体在不同单据中的角色由关系表达。",
        "普通备注不存客户密码等凭据。"
      ]
    },

    "CustomerDevice": {
      "tables": ["customer_device_custody"],
      "desc": "客户设备",
      "fields": {
        "ownerCustomerId": { "type": "id", "nullable": false },
        "deviceCode": { "type": "string", "nullable": false },
        "originalOrderId": { "type": "id", "nullable": true, "desc": "外店设备可无原订单" },
        "currentConfigurationId": { "type": "id", "nullable": true },
        "custodyLocation": { "type": "enum", "enumRef": "LocationKind", "nullable": false },
        "stockItemRef": { "type": "id", "nullable": true }
      },
      "rules": ["客户财产不进入自有库存汇总。"]
    },

    "Quote": {
      "tables": ["quotes", "quote_headers"],
      "desc": "报价聚合头",
      "fields": {
        "customerId": { "type": "id", "nullable": true },
        "title": { "type": "string", "nullable": false },
        "currentRevision": { "type": "int", "nullable": false }
      },
      "rules": ["多份草稿可引用同一二手件；已失效的引用显示「需替换」，不静默变为同型号其他件。"]
    },

    "QuoteVersion": {
      "tables": ["quotes", "templates", "quote_versions", "quote_lines"],
      "desc": "报价版本，发出后不可覆盖",
      "fields": {
        "quoteId": { "type": "id", "nullable": false },
        "revision": { "type": "int", "nullable": false },
        "status": { "type": "enum", "enumRef": "QuoteStatus", "nullable": false },
        "validUntil": { "type": "date", "nullable": true },
        "lines": { "type": "array", "nullable": false, "desc": "报价行数组，元素为报价行（quote_lines）：position / source / nameSnapshot / specSnapshot / qty / unitPriceCents / lineTotalCents / productRef / stockItemId / customerDeviceRef / warrantySnapshot。productRef 是商品引用（hardware.entity_id），草稿中的临时行可为空；new / used 行**成交（转销售单）前必须能映射到商品**（new 靠 productRef 或已指定实物，used 必须指定实物），否则不得成交 —— 见 rules 第 1 条。" },
        "discountCents": { "type": "cents", "nullable": false },
        "termsSnapshot": { "type": "object", "nullable": false },
        "issuedAt": { "type": "timestamp", "nullable": true },
        "confirmedAt": { "type": "timestamp", "nullable": true },
        "confirmedSource": { "type": "string", "nullable": true }
      },
      "rules": [
        "草稿中的临时实物行可未建档；成交前必须映射到商品。",
        "客供 / 服务不要求店有商品库存，但来源类型必须明确。",
        "每个序列化 / 二手实物行数量为 1。",
        "confirmedAt / confirmedSource 仅在 status=confirmed 时有值：确认来源为 miniprogram / wechat / offline（R10）。确认 ≠ 付款、确认不锁库存（R12）；确认后本版本不可再改，要改必须出新版本重新发出并重新确认。"
      ]
    },

    "SaleOrder": {
      "tables": ["orders", "sale_orders"],
      "desc": "销售单",
      "fields": {
        "orderNo": { "type": "string", "nullable": false },
        "customerSnapshot": { "type": "object", "nullable": false },
        "quoteVersionId": { "type": "id", "nullable": true },
        "kind": { "type": "enum", "enumRef": "SaleKind", "nullable": false },
        "tradeState": { "type": "enum", "enumRef": "SaleTradeState", "nullable": false },
        "fulfillmentState": { "type": "enum", "enumRef": "SaleFulfillmentState", "nullable": false },
        "dueAt": { "type": "timestamp", "nullable": true },
        "configurationVersion": { "type": "int", "nullable": false },
        "totalCents": { "type": "cents", "nullable": false },
        "adjustmentCents": { "type": "cents", "nullable": false },
        "cashNetCents": { "type": "cents", "nullable": false },
        "offsetNetCents": { "type": "cents", "nullable": false },
        "balanceCents": { "type": "cents", "nullable": false },
        "balanceDirection": { "type": "enum", "enumRef": "BalanceDirection", "nullable": false }
      },
      "rules": [
        "资金汇总由有效流水计算 / 维护，含 version。",
        "确认成交必须写入 confirmedQuoteVersion 指向的版本。",
        "支付状态不是可编辑下拉框，由流水与余额派生。"
      ]
    },

    "SaleLine": {
      "tables": ["order_items", "sale_lines"],
      "desc": "销售行",
      "fields": {
        "productId": { "type": "id", "nullable": true },
        "source": { "type": "enum", "enumRef": "LineSource", "nullable": false },
        "nameSnapshot": { "type": "string", "nullable": false },
        "qty": { "type": "int", "nullable": false },
        "unitPriceCents": { "type": "cents", "nullable": false },
        "discountAllocationCents": { "type": "cents", "nullable": false },
        "netLineCents": { "type": "cents", "nullable": false },
        "warrantySnapshot": { "type": "object", "nullable": true },
        "customerDeviceRef": { "type": "id", "nullable": true }
      },
      "rules": [
        "new / used 成交时需商品映射；used 指定实物。",
        "customer 客供件默认售价与成本为 0，另列装机服务费。",
        "已退数量由退货记录累计得出，不在此行直接改写。"
      ]
    },

    "Reservation": {
      "tables": ["stock_reservations"],
      "desc": "预留 / 占用",
      "fields": {
        "orderId": { "type": "id", "nullable": false },
        "lineId": { "type": "id", "nullable": false },
        "stockItemId": { "type": "id", "nullable": true, "desc": "逐件占用时必填" },
        "quantityBucketRef": { "type": "string", "nullable": true, "desc": "数量件占用时必填" },
        "qty": { "type": "int", "nullable": false },
        "status": { "type": "enum", "enumRef": "ReservationStatus", "nullable": false },
        "reason": { "type": "string", "nullable": true }
      },
      "rules": [
        "逐件有效唯一：同一 stockItemId 同一时刻最多一条 active。",
        "数量件占用总数不得超过可用量。",
        "历史占用保留，不物理删除。"
      ]
    },

    "Purchase": {
      "tables": ["purchase_orders", "purchase_lines"],
      "desc": "采购单",
      "fields": {
        "supplierRef": { "type": "id", "nullable": true },
        "supplierNote": { "type": "string", "nullable": true, "desc": "散采说明；不要求先在供应商模块建档" },
        "purchaseLines": { "type": "array", "nullable": false },
        "orderedQty": { "type": "int", "nullable": false },
        "receivedQty": { "type": "int", "nullable": false },
        "cancelledQty": { "type": "int", "nullable": false },
        "expectedAt": { "type": "timestamp", "nullable": true }
      },
      "rules": [
        "采购单数量 = 已合格入库 + 已拒收 / 取消数量 + 尚待到货数量；退供另有关联退供单。",
        "超量到货先修改确认采购量或建立追加采购，不静默增加。",
        "取消采购属补充动作，编号与契约须先补入再实现。"
      ],
      "derivedFields": [
        {
          "name": "pendingQty",
          "label": "在途 / 尚待到货",
          "formula": "orderedQty - receivedQty - cancelledQty",
          "basis": "03 §4「采购单数量 = 已合格入库 + 已拒收 / 取消数量 + 尚待到货数量」；04 §3 要求 GET /inventory/purchases 返回「采购、实到、在途、拒收 / 取消」"
        },
        {
          "name": "receiptProgress",
          "label": "部分到货判定",
          "formula": "receivedQty > 0 且 pendingQty > 0 → 部分到货；pendingQty = 0 且 receivedQty > 0 → 到货完成；receivedQty = 0 → 尚未到货",
          "basis": "05 T06b「采购 5 到 3 显示在途 2，不能整单勾完」；06 A11「采购 5 实到 3，重试本次入库，在库只增 3，在途余 2」"
        }
      ],
      "notStored": "本对象不设 status / state 字段，这是规格的有意设计而非遗漏：采购进度由 orderedQty / receivedQty / cancelledQty 三个计数器派生（04 §2 的最低字段列未含状态字段）；验收结论由关联 Receipt.inspectionDisposition 承载。存储状态会与计数器产生第二真相来源，允许两者漂移；派生可保证恒等式始终成立。",
      "revision": "2026-09-17 T01-rev1 补录。T01a 未记录派生关系，T01b 曾误将其登记为「对象层遗漏」；经核对 03 §4、04 §2/§3、05 T06b、06 A11 后更正。"
    },

    "Receipt": {
      "tables": ["purchase_receipts", "purchase_receipt_lines"],
      "desc": "到货验收（一次到货一条）",
      "fields": {
        "purchaseId": { "type": "id", "nullable": true, "desc": "快速采购时可为 null" },
        "quickPurchaseNote": { "type": "string", "nullable": true },
        "receiptLines": { "type": "array", "nullable": false },
        "unitCostCents": { "type": "cents", "nullable": true },
        "inspectionDisposition": { "type": "enum", "enumRef": "InspectionDisposition", "nullable": false },
        "receivedAt": { "type": "timestamp", "nullable": false }
      },
      "rules": [
        "部分到货分次 Receipt，每次各有 requestId。",
        "入库关联采购来源与成本；不能只录 SN 当完整采购。",
        "到货不自动把货给任意最旧订单。"
      ]
    },

    "InventoryMovement": {
      "tables": ["sn_events"],
      "desc": "库存流水",
      "fields": {
        "productId": { "type": "id", "nullable": false },
        "stockItemId": { "type": "id", "nullable": true },
        "qty": { "type": "int", "nullable": false, "desc": "增量，可正可负" },
        "fromBucket": { "type": "enum", "enumRef": "StockBucket", "nullable": true },
        "toBucket": { "type": "enum", "enumRef": "StockBucket", "nullable": true },
        "costCents": { "type": "cents", "nullable": true },
        "source": { "type": "enum", "enumRef": "InventoryMovementSource", "nullable": false },
        "reversalOf": { "type": "id", "nullable": true }
      },
      "rules": [
        "每项业务副作用有唯一来源标识，能追溯 / 重算。",
        "已完成的库存记录不直接改写或删除，使用关联冲销 / 调整记录。"
      ]
    },

    "Checklist": {
      "tables": ["sale_checklists"],
      "desc": "装机检查单（打包、外观、SN 核对等）",
      "fields": {
        "entityRef": { "type": "object", "nullable": false },
        "templateVersion": { "type": "string", "nullable": false },
        "configurationVersion": { "type": "int", "nullable": false },
        "items": { "type": "array", "nullable": false },
        "result": { "type": "enum", "enumRef": "ChecklistResult", "nullable": false },
        "performedAt": { "type": "timestamp", "nullable": true },
        "performedBy": { "type": "id", "nullable": true }
      },
      "rules": [
        "使用时固化模板版本。",
        "改配置 / 换件让受影响的配置核对与检测项失效；改附件让打包项失效。",
        "交付前后端验证 configurationVersion 等于当前版本。"
      ]
    },

    "TestRecord": {
      "tables": ["sale_checklists"],
      "desc": "检测记录（点亮、烤机等）",
      "fields": {
        "entityRef": { "type": "object", "nullable": false },
        "templateVersion": { "type": "string", "nullable": false },
        "configurationVersion": { "type": "int", "nullable": false },
        "items": { "type": "array", "nullable": false },
        "result": { "type": "enum", "enumRef": "ChecklistResult", "nullable": false },
        "performedAt": { "type": "timestamp", "nullable": true },
