    "ReturnRecord": {
      "tables": ["sale_returns"],
      "desc": "退货接收与贷项",
      "fields": {
        "originalOrderId": { "type": "id", "nullable": false },
        "lineAllocations": { "type": "array", "nullable": false, "desc": "原行 / 数量 / 实物分配" },
        "stockItemIds": { "type": "array", "nullable": false },
        "reason": { "type": "string", "nullable": false },
        "acceptedQty": { "type": "int", "nullable": false },
        "creditCents": { "type": "cents", "nullable": false },
        "creditState": { "type": "enum", "enumRef": "CreditState", "nullable": false },
        "refundEntryRef": { "type": "id", "nullable": true }
      },
      "rules": [
        "实物接收、贷项、现金退款各有独立状态与引用。",
        "累计退货贷项不超过原行净额；已退数量由本记录累计。",
        "未收到实物不能凭退款增加库存。"
      ],
      "factMapping": [
        {
          "fact": "实物接收",
          "stateCarrier": "StockItem.availability / 库存桶（收货后进入待检 quarantine，不自动可卖）",
          "refField": "stockItemIds",
          "verdict": "已核实：03 §4「销售退回接收 → 在库与待处理增加，验收实物后」；03 §7「库存先进入待检，绝不自动可卖」"
        },
        {
          "fact": "现金退款",
          "stateCarrier": "Refund 单据（独立对象，资金方式、发生时间、冲销各自记录）",
          "refField": "refundEntryRef",
          "verdict": "已核实：Refund 对象独立存在，本字段为其引用；03 §7「现金退款可稍后」"
        },
        {
          "fact": "贷项",
          "stateCarrier": "ReturnRecord.creditState（pending → approved，老板审批）",
          "refField": "creditCents / lineAllocations",
          "verdict": "已核实（2026-09-21 E09 栋哥拍板）：退货产生的应退贷项须老板审批才生效。creditState 由 pending（待审批）经 B43 批准转为 approved（生效，计入应退）；B18 退款只能对 approved 贷项执行。"
        }
      ],
      "notStored": "本对象只在「贷项」上设单一 creditState 字段（pending / approved，老板审批生效）；实物接收与现金退款仍由关联对象各自承接状态（StockItem.availability 与 Refund）。不设整单总状态，是因为三者进度独立（03 §7「退货实物可待检，现金退款可稍后；二者独立」），一个总状态会掩盖差异。",
      "revision": "2026-09-17 T01-rev1 补录。T01b 曾误将其登记为「对象层遗漏 / high」；经核对 04 §2 字段列实无状态字段、三个状态由关联对象承接后更正为规格未定义（贷项一项仍待决）。2026-09-21 E09 把贷项一项落地：tables 由 [] 补 sale_returns，新增 creditState 字段（CreditState 枚举 pending/approved）。"
    },

