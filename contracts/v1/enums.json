      "desc": "待检通过后的处置去向。进入 available 才可卖"
    },
    "ChecklistItemState": {
      "values": ["pending", "pass", "fail"],
      "desc": "检查项事实记录。checkbox 是已完成事实的记录，不能代替真正测试"
    },
    "ChecklistResult": {
      "values": ["incomplete", "passed", "failed"],
