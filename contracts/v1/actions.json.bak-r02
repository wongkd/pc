      "stateMachine": "RecoveryState",
      "status": "frozen",
      "operations": [
        { "method": "POST", "path": "/inventory/items/:id/refurbishments", "permission": "inventory/refurbish" },
        { "method": "POST", "path": "/inventory/items/:id/make-available", "permission": "inventory/refurbish" }
      ],
      "inputs": ["明细成本:RefurbishmentLine[]", "检测:InspectionResult", "成色:ConditionGrade!", "披露:Disclosure!", "质保:WarrantyTerm!", "标价:cents!"],
      "result": "记录整备事件或达成上架门槛。逐件编号、成色、检测、成本、披露、标价、质保齐备方可上架。",
      "effects": ["RefurbishmentCost", "StockItem", "StockBalance"],
      "errors": ["INSPECTION_REQUIRED", "VERSION_CONFLICT", "VALIDATION_ERROR"],
      "uiRefs": ["整备 / 上架", "库存"],
      "notes": [
        "acquired → refurbishing → ready_for_sale，或无需整备时直接补齐门槛（enums.json）。",
        "成本示例见 03 §7：收购 800 + 整备 80 = 880，交付只确认 880，不新增「采购 880」现金。"
      ]
    },
    {
      "code": "B44",
      "name": "拆件入库",
      "domain": "recovery",
      "entity": "RecoveryTeardown",
