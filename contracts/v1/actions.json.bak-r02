      "operations": [{ "method": "POST", "path": "/recovery/orders/:id/teardown", "permission": "recovery/edit" }],
      "inputs": ["sourceStockItemId:StockItemRef!", "outputs:TeardownOutput[]!", "scrapLines:ScrapLine[]", "occurredAt:timestamp!"],
      "result": "整机拆件：源件退役、产出件新建待检、损耗单列报废；产出成本 + 损耗 = 源件成本。",
      "effects": ["RecoveryTeardown", "StockItem", "InventoryMovement", "Recovery"],
      "errors": ["OWNERSHIP_INVALID", "VERSION_CONFLICT", "INSPECTION_REQUIRED", "VALIDATION_ERROR", "PERMISSION_DENIED"],
      "uiRefs": ["回收"],
      "notes": [
