    ]
  },
  "actions": [
    {
      "code": "B01",
      "name": "创建报价草稿",
      "domain": "sales",
      "entity": "Quote",
      "stateMachine": "QuoteStatus",
      "status": "frozen",
      "operations": [{ "method": "POST", "path": "/sales/quotes", "permission": "sales/quote-edit" }],
      "inputs": ["customer:CustomerRef?", "title:string?", "lines:SaleLine[]", "terms:Terms?", "validUntil:datetime?"],
      "result": "新建 Quote，状态 draft。最少草稿允许先为空；完整度只在 issue（B02）与 convert（B03）强制。",
      "effects": ["Quote"],
      "errors": ["VALIDATION_ERROR", "AUTH_REQUIRED", "PERMISSION_DENIED", "SERVICE_UNAVAILABLE"],
      "uiRefs": ["新建装机报价", "选件"],
      "notes": [
        "选件页允许新品 / 二手现货 / 客供 / 服务四类来源；二手行必须带 StockItem 实物 ID，客供件不计自有库存（02 §5、03 领域规则）。",
        "报价阶段不锁货（02 §5）。"
      ]
    },
    {
      "code": "B02",
      "name": "保存与发出报价",
      "domain": "sales",
      "entity": "QuoteVersion",
      "stateMachine": "QuoteStatus",
      "status": "frozen",
      "operations": [
        { "method": "POST", "path": "/sales/quotes/:id/save", "permission": "sales/quote-edit" },
        { "method": "POST", "path": "/sales/quotes/:id/issue", "permission": "sales/quote-edit" }
      ],
      "inputs": ["revision:int!", "编辑字段:同B01字段集", "issue额外要求:完整配置行与条款"],
      "result": "生成新草稿版本；issue 生成不可变已发版本，原客户版本不被覆盖。",
      "effects": ["QuoteVersion", "Quote"],
      "errors": ["VALIDATION_ERROR", "VERSION_CONFLICT", "PERMISSION_DENIED", "IDEMPOTENCY_MISMATCH"],
      "uiRefs": ["新建装机报价", "选件"],
      "notes": [
        "issued 状态再次 save 形成新版本而非原地改写（enums.json QuoteStatus 自环转换）。",
        "优惠分摊与金额重算见 money-rules.json。"
      ]
    },
    {
      "code": "B03",
      "name": "报价转为销售单",
      "domain": "sales",
      "entity": "SaleOrder",
      "stateMachine": "QuoteStatus",
      "status": "frozen",
      "operations": [{ "method": "POST", "path": "/sales/quotes/:id/convert", "permission": "sales/quote-convert" }],
      "inputs": [
        "quoteVersion:int!",
        "customerSnapshot:CustomerSnapshot!",
        "dueAt:datetime!",
        "allocationChoices:AllocationChoice[]!",
        "lineProductMap:LineProductMap[]（行序 → hardware.entity_id；报价行没带商品引用时在转单时补）"
      ],
      "result": "生成销售单与数量缺口清单。本动作不写预留：R07（未付款不预留不采购）优先于旧措辞「现货预留」，实际占用由 B05 在收到定金后写。成交前 new / used 行必须映射到商品（QuoteVersion.rules 第 1 条），映射不出则整次失败；指定二手实物已被占用时同样整次失败，不部分成功。",
      "effects": ["SaleOrder", "Reservation", "Quote"],
      "errors": ["STOCK_CONFLICT", "VERSION_CONFLICT", "OWNERSHIP_INVALID", "VALIDATION_ERROR"],
      "uiRefs": ["确认成交"],
      "notes": [
        "冲突处理策略见 conventions.write 与 errors.json STOCK_CONFLICT。",
        "⚠️ effects 列出 Reservation 只表示「本动作定下了要占什么（哪些行、哪件实物）」这一占用意向；B03 本身不写任何 stock_reservations / inventory_movements 行。实际写入在 B05（enums.json inventoryBucketRules 把 available → reserved 绑在 B05 上）。",
        "lineProductMap 是为「报价行 product_ref 为空」准备的补救口：草稿允许临时行（QuoteVersion.rules 第 1 条），而已发出的版本不可回改，因此补映射只能发生在转单这一步，结果只写进 sale_lines，不回头改报价版本。"
      ]
    },
    {
      "code": "B04",
      "name": "创建零售与直接销售单",
      "domain": "sales",
      "entity": "SaleOrder",
      "stateMachine": "SaleTradeState",
      "status": "frozen",
      "operations": [{ "method": "POST", "path": "/sales/orders", "permission": "sales/order-edit" }],
      "inputs": ["kind:SaleKind!", "customerSnapshot:CustomerSnapshot!", "lines:SaleLine[]!", "terms:Terms!", "dueAt:datetime?"],
      "result": "生成销售单草稿（draft），仍须调用 B05 confirm 才锁货。",
      "effects": ["SaleOrder"],
      "errors": ["VALIDATION_ERROR", "PERMISSION_DENIED"],
      "uiRefs": ["新建零售"],
      "notes": ["零售单可跳过装机与检测（enums.json SaleFulfillmentState：waiting_stock 可直达 ready_delivery）。"]
    },
    {
      "code": "B05",
      "name": "确认成交与补分配",
      "domain": "sales",
      "entity": "Reservation",
      "stateMachine": "SaleTradeState",
      "status": "frozen",
      "operations": [
        { "method": "POST", "path": "/sales/orders/:id/confirm", "permission": "sales/order-edit" },
        { "method": "POST", "path": "/sales/orders/:id/allocate", "permission": "sales/order-edit" }
      ],
      "inputs": ["最新行数据:SaleLine[]", "候选实物或数量分配:AllocationChoice[]"],
      "result": "成交并原子预留；或对缺口补充占用。服务端重新计算缺口，不信任客户端剩余量。",
      "effects": ["SaleOrder", "Reservation", "StockItem", "StockBalance"],
      "errors": ["STOCK_CONFLICT", "VERSION_CONFLICT", "OWNERSHIP_INVALID", "INSPECTION_REQUIRED"],
      "uiRefs": ["确认成交", "缺件处理"],
      "notes": [
        "确认成交时商品行映射、最终价格与质保、客户承诺须完整；已被占用的指定二手件必须换件或取消该行（02 §5、enums.json）。",
        "补分配缺件不改变交易状态（enums.json SaleTradeState 自环）。"
      ]
    },
    {
      "code": "B06",
      "name": "开始备料与装机",
      "domain": "sales",
      "entity": "SaleOrder",
      "stateMachine": "SaleFulfillmentState",
      "status": "frozen",
      "operations": [{ "method": "POST", "path": "/sales/orders/:id/start-assembly", "permission": "sales/order-assembly" }],
      "inputs": ["领料位置:StockLocation!", "客供件接收引用:ReceiptRef?"],
      "result": "记录备料事实与阶段推进；不扣销量、不改变成交状态。",
      "effects": ["SaleOrder", "InventoryMovement"],
      "errors": ["VERSION_CONFLICT", "STOCK_CONFLICT", "OWNERSHIP_INVALID"],
      "uiRefs": ["装机检测"],
      "notes": ["waiting_stock → preparing 的守卫：所需店有件已预留、客供件已接收（enums.json）。"]
    },
    {
      "code": "B07",
      "name": "保存装机检测结果",
      "domain": "sales",
      "entity": "Checklist",
      "stateMachine": "SaleFulfillmentState",
      "status": "frozen",
      "operations": [{ "method": "POST", "path": "/sales/orders/:id/checks", "permission": "sales/order-assembly" }],
      "inputs": ["templateVersion:int!", "configurationVersion:int!", "changedItems:ChecklistItem[]!", "resultEvidence:AttachmentRef[]"],
      "result": "保存检查结果并刷新 version 与阻断项；检测不通过时隔离故障件、释放该件预留并重新形成缺口。",
      "effects": ["Checklist", "TestRecord", "SaleOrder", "Reservation"],
      "errors": ["VERSION_CONFLICT", "CHECKLIST_INCOMPLETE", "SERIAL_MISMATCH"],
      "uiRefs": ["装机检测"],
      "notes": [
        "失败项目禁止自动打勾（02 §5 装机检测行）。",
        "「不能勾中就假装已经服务器保存」（02 §6 ActionChecklist）。"
      ]
    },
    {
      "code": "B08",
