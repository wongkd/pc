      "operations": [{ "method": "POST", "path": "/sales/orders/:id/deliver", "permission": "sales/order-deliver" }],
      "inputs": ["configurationVersion:int!", "checklistVersion:int!", "deliveryNote:string!", "creditApprovalRef:Ref?"],
