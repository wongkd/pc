      ]
    },
    {
      "code": "B35",
      "name": "附件上传",
      "domain": "platform",
      "entity": "Attachment",
      "stateMachine": "AttachmentUploadState",
      "status": "frozen",
      "operations": [
        { "method": "POST", "path": "/attachments/upload-intents", "permission": "attachment/upload" },
        { "method": "PUT", "path": "/attachments/upload-intents/:id/blob", "permission": "attachment/upload" },
        { "method": "POST", "path": "/attachments/upload-intents/:id/complete", "permission": "attachment/upload" }
      ],
      "inputs": ["ownerEntityRef:Ref!", "purpose:AttachmentPurpose!", "mime:string!", "byteSize:int!", "文件完整性:sha256"],
      "result": "签发临时上传凭证；验证文件完整性后可关联为业务附件。",
      "effects": ["Attachment"],
      "errors": ["VALIDATION_ERROR", "RATE_LIMITED", "PERMISSION_DENIED"],
      "uiRefs": ["接修", "回收"],
      "notes": [
        "对象存储与 D1 不构成同一事务：先上传验证后关联，孤立上传需明确保留期与引用检查（04 §7 第 9 条）。",
        "default 单张压缩后不超过 2MB、每单常规不超过 12 张，属产品预算而非平台上限（04 §9）。",
        "F1（2026-09-22）契约修订：补入 PUT /attachments/upload-intents/:id/blob 作为文件字节的实际通道。04 §5 只规定签发凭证与完成确认两个端点，字节通道原本留白；由服务端经手字节，才能实算 sha256 与真实 mime，而不是信任客户端自报的完整性。",
        "同次补入 enums.json 的 AttachmentUploadState 转换表，stateMachine 由 null 指过去（pending→uploaded→attached、pending→failed、pending/uploaded→orphaned）。"
      ]
    },
